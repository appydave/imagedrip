{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    // The scripts are plain ESM so `node scripts/x.mjs` runs on any Node 20+
    // with no build step and no type-stripping flag — the MCP server is
    // launched by a `.mcp.json` on whatever Node the user has. JSDoc + checkJs
    // buys the type safety back without a compile step.
    "noImplicitAny": false
  },
  "include": ["scripts/**/*.mjs"]
}
